# ── Dependencies ───────────────────────────────────────────────────────────────
node_modules/

# ── Build output (Vercel builds this itself — don't commit) ───────────────────
frontend/dist/
frontend/.vite/

# ── Env files with real values ────────────────────────────────────────────────
# *.example files ARE committed (they are templates).
# Everything else holds real keys/URLs and must stay local.
.env
.env.local
.env.*.local

# ── Training-mode annotations (per-user, written at runtime) ──────────────────
# (covers backend/data/games-mirror/ — the local Game Review mirror — as well)
backend/data/

# ── Game analysis report (generated from mirror, regenerate on demand) ───────
docs/games-report.html

# ── Playwright smoke screenshots ──────────────────────────────────────────────
frontend/tests/shots/

# ── Playwright MCP session traces (per-session, regenerated on use) ──────────
.playwright-mcp/

# ── OS / editor noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

.claude/settings.local.json

# ── QA / scratch artifacts (kept on disk, not tracked) ───────────────────────
verification-screenshots/
master-screenshots/
pass1-screenshots/
pass4-screenshots/

# ── Session scratch docs at repo root (kept on disk, not tracked) ────────────
# Pass reports + recon/snapshot/sync artifacts. Pre-ignore future pass reports
# here too (e.g. DECK.md) so they don't drift back into tracking.
COMPLETION.md
DECK.md
RECON.md
SNAPSHOT.md
SYNC.md
PASS1.md
PASS4.md
LUMIERE.md
reference.jpeg
